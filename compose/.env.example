# 로컬 Compose 설정. cp .env.example .env 로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 값은 따옴표 없이 한 줄로, '$'는 쓰지 않는다(Compose가 변수로 읽는다). 비밀 키 이름은 overlays/school/secret.env.example과 같다.
# 컨테이너에는 docker-compose.yml이 서비스마다 필요한 키만 넘긴다. 새 비밀 키를 더하면 그 서비스의 environment에도 적는다.

# ── 주소·이미지 ──
# 사용자가 여는 web 주소. 끝에 /는 붙이지 않는다. QR 링크·CORS·사전 서명 URL 앞부분이 모두 이 값이다
#   노트북 혼자: http://localhost:8315 / 학교 서버: https://gakdo.site (강사님 nginx가 8315로 넘김)
# 폰 촬영(카메라)은 HTTPS 주소에서만 된다
PUBLIC_BASE_URL=
# web이 받을 포트와 주소(기본 0.0.0.0:8315)
WEB_PORT=
WEB_BIND=
# RabbitMQ·MinIO 포트를 열 주소(기본 127.0.0.1). 집 PC 워커가 같은 망에서 붙어야 하면 0.0.0.0
INFRA_BIND=
# 호스트 포트(기본 5672·15672·9000·9001). 같은 기기에 다른 RabbitMQ·MinIO가 있어 겹치면 바꾼다
#   학교 서버(10.116.64.12)는 9000·9001을 다른 MinIO가 쓰므로 예: MINIO_HOST_PORT=19000, MINIO_CONSOLE_HOST_PORT=19001
RABBITMQ_HOST_PORT=
RABBITMQ_MGMT_HOST_PORT=
MINIO_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
# GHCR 이미지 태그(기본 develop). 앱 하나만 바꾸려면 GATEWAY_TAG·AUTH_SERVER_TAG·RENTAL_SERVER_TAG·CAPTURE_SERVER_TAG·
# DIAGNOSTICS_SERVER_TAG·REPORT_SERVER_TAG·INSPECT_WORKER_TAG·WEB_TAG (예: 커밋 SHA 또는 latest)
TRACE_TAG=

# ── 비밀값 (필수) ──
# PostgreSQL 관리자(postgres)와 앱 계정. 앱 계정과 스키마는 postgres가 처음 뜰 때 init-db.sh가 만든다
POSTGRES_PASSWORD=
DB_USERNAME=
DB_PASSWORD=
# RabbitMQ·Redis 계정(이 Compose 안에서만 쓰는 값)
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# MinIO 관리자 키 = 앱이 쓰는 키(capture-server·report-server, 로컬 MinIO 전용, 학교 MinIO 키를 넣지 않는다)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── auth-server ──
# JWT 서명 개인 키(PKCS#8 PEM 한 줄): openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
# 비우면 시작할 때마다 새 키를 만들어 재시작하면 로그인이 풀린다
JWT_PRIVATE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
BOOTH_CLIENT_ID=
BOOTH_CLIENT_SECRET=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# 팀 Gmail 계정과 앱 비밀번호(인증 메일). 비우면 메일만 실패한다
SMTP_USERNAME=
SMTP_PASSWORD=

# ── report-server·diagnostics-server ──
# 해시 체인 서명 키(필수, Ed25519 PKCS#8 PEM을 base64 한 줄로): openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# 한 번 만든 키는 바꾸지 않는다. 바꾸면 이전 봉인의 서명 검증이 실패한다
CHAIN_SIGNING_KEY=
# InfluxDB 쓰기 토큰(infra.env INFLUX_URL을 채운 경우만)
INFLUX_TOKEN=

# 성능 그래프 모델별 mAP(capture-server). "모델버전=mAP50/mAP50-95", 여럿은 쉼표, 모르는 값은 -. 학습이 끝나면 채운다
MODEL_METRICS=

# ── inspect-worker(폰 사진 정합·탐지) ──
# 모델 파일은 여기 쓰지 않는다. compose/models/에 best.onnx·model.json을 넣는다(models/README.md)
# 바꿀 때만 앞의 #을 지우고 값을 쓴다(빈 값은 숫자로 읽지 못해 기동이 실패한다)
# TRACE_DETECT_CONF=0.25        # 탐지 문턱
# TRACE_DETECT_THREADS=2        # onnxruntime CPU 스레드
# INSPECT_WORKER_CPUS=2         # 컨테이너 CPU 수
# TRACE_DEVICE_MODEL=MBA13-M2   # 이벤트에 기종이 없을 때 기본 기종
