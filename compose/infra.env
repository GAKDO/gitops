# 로컬 Compose의 비밀 아닌 접속 주소. 이름은 overlays/school/infra.env와 같고 값만 Compose 서비스 이름이다.
# 비밀번호·키·토큰은 여기 쓰지 않는다(.env, .env.example 참고).
# 공개 주소에서 나오는 WEB_PUBLIC_URL·TRACE_WEB_ORIGIN·MINIO_PUBLIC_BASE는 docker-compose.yml이 .env의 PUBLIC_BASE_URL로 넣는다.

# PostgreSQL: DB trace, 서비스마다 스키마 하나(init-db.sh)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ: vhost /trace (관리 화면은 이 기기의 15672)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/trace

# MinIO(S3 API): 버킷 trace-captures·trace-derived는 minio-init이 만든다
MINIO_ENDPOINT=http://minio:9000

# Redis: 키는 모두 trace: 접두사
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=2
REDIS_KEY_PREFIX=trace:

# InfluxDB(파일럿 추이)는 Compose에 없다. 학교 InfluxDB는 내부망 전용이라 학교 서버에서 띄울 때만 채운다
INFLUX_URL=
INFLUX_BUCKET=trace-pilot
INFLUX_ORG=

# Gmail SMTP: 인증·재설정 코드 메일(auth-server). 계정과 앱 비밀번호는 .env
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# gateway 요청 제한이 셀 실제 사용자 IP. web nginx가 X-Real-IP에 연결 주소를 넣는다
# (앞에 강사님 nginx 같은 프록시가 있으면 그 프록시 주소가 된다)
TRACE_CLIENT_IP_HEADER=X-Real-IP

# 서버끼리 부르는 주소 (Compose 서비스 이름:8080)
AUTH_SERVER_URL=http://auth-server:8080
RENTAL_SERVER_URL=http://rental-server:8080
CAPTURE_SERVER_URL=http://capture-server:8080
DIAGNOSTICS_SERVER_URL=http://diagnostics-server:8080
REPORT_SERVER_URL=http://report-server:8080
