# trace 네임스페이스의 Secret 두 개에 들어갈 키 이름 목록이다. 값은 이 파일에 쓰지 않는다.
# cp secret.env.example secret.env 로 복사해 값을 채운 뒤 scripts/create-secrets.sh 를 돌린다. secret.env는 커밋하지 않는다(.gitignore).
# Rancher 화면(Storage → Secrets, 네임스페이스 trace)에서 같은 이름·키로 직접 만들어도 된다.
# 값은 따옴표 없이 한 줄로 쓴다. PEM 같은 여러 줄 값은 앱과 정한 한 줄 형식(예: base64 -w0)으로 바꿔 넣는다.

# ── trace-secrets: gateway와 서버 5개가 envFrom으로 받는다 ──
# PostgreSQL 앱 계정. 클러스터 안 postgres가 처음 뜰 때 이 계정으로 DB trace를 만든다 (필수)
DB_USERNAME=
DB_PASSWORD=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# MinIO 팀 계정. 앱과 매일 DB 백업(pg-backup)이 같이 쓴다
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# InfluxDB trace-pilot 쓰기 토큰 (diagnostics-server)
INFLUX_TOKEN=
# grafana(파일럿 대시보드) 관리자 admin의 비밀번호와 trace-pilot 읽기 전용 토큰. 둘 다 없으면 grafana가 시작하지 않는다
GRAFANA_ADMIN_PASSWORD=
INFLUX_READ_TOKEN=
ELASTIC_PASSWORD=
# 팀 Gmail 계정과 Gmail 앱 비밀번호
SMTP_USERNAME=
SMTP_PASSWORD=
# auth-server의 JWT 서명 개인 키. PKCS#8 PEM을 한 줄로: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
JWT_PRIVATE_KEY=
# auth-server 초기 관리자 계정(없을 때만 만든다. 바꾸려면 DB에서 지운 뒤 재시작)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 부스(Jetson) client 자격. ID는 32자 이하이고 그대로 boothId가 된다. 부스 쪽 설정에도 같은 값을 넣는다
BOOTH_CLIENT_ID=
BOOTH_CLIENT_SECRET=
# auth-server 시연용 고객 계정(선택. 이메일 인증 완료 CUSTOMER로, 없을 때만 만든다. 비우면 만들지 않음)
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# 해시 체인 서명 키
CHAIN_SIGNING_KEY=

# ── trace-postgres: PostgreSQL 관리자 비밀번호와 Label Studio DB 계정 (셋 다 필수) ──
POSTGRES_PASSWORD=
# Label Studio가 labelstudio DB에 붙는 계정. postgres가 처음 뜰 때 만든다
POSTGRE_USER=
POSTGRE_PASSWORD=
