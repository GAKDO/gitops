# 비밀이 아닌 설정만 둔다. ConfigMap trace-infra가 되어 gateway와 서버 5개가 envFrom으로 모두 받는다.
# 비밀번호·키·토큰은 여기 쓰지 않는다 (trace-secrets, secret.env.example 참고).
# 값을 바꾸면 ConfigMap만 바뀌고 파드는 그대로다: kubectl -n trace rollout restart deploy

# PostgreSQL: 학교 공용 DB를 받지 못해 클러스터 안 StatefulSet(base/postgres)을 쓴다. DB trace, 서비스마다 스키마 하나
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ: 팀 vhost /trace (관리 화면 15672)
RABBITMQ_HOST=s4.java21.net
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/trace

# MinIO(S3 API): 버킷 trace-captures·trace-derived(서비스), trace-backups(매일 DB 백업)
MINIO_ENDPOINT=https://storage.java21.net

# Redis: 클러스터에서는 학교 내부망 주소로 붙는다. DB 2번(학번 끝자리 규칙), 키는 모두 trace: 접두사
REDIS_HOST=10.116.64.14
REDIS_PORT=6379
REDIS_DATABASE=2
REDIS_KEY_PREFIX=trace:

# InfluxDB: 파일럿 추이 (diagnostics-server가 쓰고 우리 grafana가 읽는다). INFLUX_ORG는 InfluxDB 조직 이름(A가 확인해 채운다)
INFLUX_URL=http://influx.java21.net
INFLUX_BUCKET=trace-pilot
INFLUX_ORG=

# Elasticsearch: 기록 검색 복사본 (report-server, 선택 기능)
ELASTICSEARCH_URL=http://s4.java21.net:9200

# Gmail SMTP: 인증·재설정 코드 메일 (auth-server). 계정과 앱 비밀번호는 trace-secrets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 고객이 여는 web 주소. auth-server가 수령 QR 링크(<주소>/capture?t=...)를 만들 때 쓴다. 끝에 /는 붙이지 않는다
# Cloudflare Tunnel(base/apps/cloudflared)이 https://gakdo.site 를 받아 /api/* 는 gateway, 나머지는 web으로 보낸다(같은 출처)
WEB_PUBLIC_URL=https://gakdo.site
# gateway CORS가 허용할 web 출처(여러 개면 쉼표). 글자 단위로 비교하니 WEB_PUBLIC_URL과 똑같이 쓴다
TRACE_WEB_ORIGIN=https://gakdo.site
# gateway 요청 제한이 셀 실제 사용자 IP 헤더. 터널 뒤라 연결 주소는 cloudflared 파드 IP다
TRACE_CLIENT_IP_HEADER=CF-Connecting-IP

# 같은 네임스페이스 안 서버끼리 부르는 주소 (Service 이름:8080)
AUTH_SERVER_URL=http://auth-server:8080
RENTAL_SERVER_URL=http://rental-server:8080
CAPTURE_SERVER_URL=http://capture-server:8080
DIAGNOSTICS_SERVER_URL=http://diagnostics-server:8080
REPORT_SERVER_URL=http://report-server:8080
